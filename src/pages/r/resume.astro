---
import { href } from "../../utils/paths";

const target = href("/resume");
const title = "Opening resume…";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      Redirecting… If it doesn’t happen,
      <a href={target}>click here</a>.
    </p>
    <script
      is:inline
      set:html={`window.location.replace(${JSON.stringify(target)});`}
    />
  </body>
</html>

