---
import { site } from "../../config/site";
import { href } from "../../utils/paths";

const target = href(site.resumePdfPath);
const title = "Downloading resume…";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      Download should start automatically. If it doesn’t,
      <a href={target}>click here</a>.
    </p>
    <script
      is:inline
      set:html={`window.location.replace(${JSON.stringify(target)});`}
    />
  </body>
</html>

